# Smart Shishu Shikkha - Environment Variables
# Put real keys ONLY in .env.local (never commit) or in Vercel > Settings > Environment Variables.
# Every variable is OPTIONAL. With none set, the app uses its built-in offline teacher.
# Providers are tried in this order; if one is out of free quota the next one is used:
#   custom -> Groq -> Cloudflare -> Gemini -> built-in offline teacher

# 1) Groq (free tier, fast)  https://console.groq.com
GROQ_API_KEY=
# Model names change over time. Open  /api/status  on your site to see the names your key can use.
GROQ_MODEL=openai/gpt-oss-20b

# 2) Cloudflare Workers AI (free daily allowance)  https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model names change over time. /api/status lists the names your account can use (cloudflareModels).
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# 3) Google Gemini (free tier). NOTE: Google may use free-tier content to improve its products,
#    so it is used last. Leave empty if you do not want that.  https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: any other OpenAI-compatible provider (set BOTH key and URL)
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# PRIVATE diagnostic page. Leave empty to keep /api/status switched off.
# To use it set a long random value (12+ characters), then open  /api/status?key=THAT_VALUE
STATUS_SECRET=
